# Configuración del correo del formulario de contacto (SMTP)
# Copia este archivo como .env y completa con tus datos reales.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# "true" solo para puertos SSL clásicos (normalmente 465). Para 587 deja false.
SMTP_SECURE=false
SMTP_USER=probus.contacto@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicación

# Remitente que verá la persona que recibe el mensaje
SMTP_FROM=probus.contacto@gmail.com

# Bandeja que recibe las consultas del sitio
CONTACT_TO_EMAIL=probus.contacto@gmail.com
